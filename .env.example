# PostgreSQL connection string.
# Local dev (Postgres listening on 127.0.0.1:5432):
DATABASE_URL="postgresql://kids:kids_dev_pw@127.0.0.1:5432/kids_portfolio?schema=public"
# Inside docker-compose the app reaches the db over the internal network:
# DATABASE_URL="postgresql://kids:kids_dev_pw@db:5432/kids_portfolio?schema=public"

# NextAuth
# Generate a strong value with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Seeded admin (parents) account
ADMIN_EMAIL="parent@example.com"
ADMIN_PASSWORD="ChangeThisPassword123!"

# Where uploaded files are written (mounted volume in production)
UPLOAD_DIR="./uploads"

# AI analysis (optional — pick one or both; the UI lets parents choose)
# Gemini (also accepted: GEMINI_LUMEN_API_KEY, GOOGLE_API_KEY)
GEMINI_API_KEY=""
# DeepSeek
DEEPSEEK_API_KEY=""
# Optional model overrides
# GEMINI_MODEL="gemini-3.6-flash"
# DEEPSEEK_MODEL="deepseek-chat"
